<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dashboardnew</groupId>
    <artifactId>dashboard-middleware</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Fully-qualified entry point that starts all 6 middleware services -->
        <main.class>com.dashboardnew.middleware.LauncherMain</main.class>
    </properties>

    <!--
        No <dependencies> block yet — the project currently only uses
        com.sun.net.httpserver, which ships with the JDK. When you add a
        real dependency later (Jackson/Gson for JSON, an HTTP client, etc.)
        it goes here, e.g.:

        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.17.0</version>
            </dependency>
        </dependencies>
    -->

    <build>
        <finalName>dashboard-middleware-${project.version}</finalName>
        <plugins>
            <!-- Compiles src/main/java using the Java version above -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                Bundles all 6 middleware classes + LauncherMain + (any future
                dependencies) into ONE runnable jar with a Main-Class manifest
                entry, so `java -jar target/dashboard-middleware-1.0.0.jar`
                runs everything.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
